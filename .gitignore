# Download transport archives can include runtime bytecode/cache directories.
# Their extracted scientific results and frozen source are published instead.
mdlm/artifacts/current/*_results.tar.gz
mdlm/artifacts/current/camera_ready_same_run_logit/code_failed_job_2081343.tar.gz

